# =============================================================================
#  FamilyPlatform — hardened .htaccess
#  Revised 2026-09-17  ·  branch: main
#  Owner: Felix Dreyden (Red Team – Infra) / Oladele (Deployment)
# =============================================================================

RewriteEngine On

# ---------------------------------------------------------------------------
# 0. Secrets directory. app/config/_env.php reads .env from APP_ENV_DIR if that
#    directory holds a readable .env, otherwise it falls back to the project
#    root — so a wrong/missing path is harmless. Set the production value here;
#    it is a filesystem path, not a secret.
# ---------------------------------------------------------------------------
<IfModule mod_env.c>
    SetEnv APP_ENV_DIR /home/bestiias/private
</IfModule>

# ---------------------------------------------------------------------------
# 1. Dot-files and dot-directories — .git, .env*, .htaccess, .gitignore …
#    (exception: /.well-known/ for ACME + app links)
# ---------------------------------------------------------------------------
RewriteRule "(^|/)\.(?!well-known/)" - [F,L]

# ---------------------------------------------------------------------------
# 2. Application source / tooling directories — nothing servable lives here.
#    (resources/assets + resources/images stay reachable; only views blocked)
# ---------------------------------------------------------------------------
RewriteRule "^(app|bootstrap|database|scripts|tests|cypress|docs|storage|scratch|tmp|node_modules|vendor)(/|$)" - [F,L]
RewriteRule "^resources/views(/|$)" - [F,L]

# ---------------------------------------------------------------------------
# 3. PHP execution lock-down — only the front controller runs.
# ---------------------------------------------------------------------------
<FilesMatch "\.php$">
    Require all denied
</FilesMatch>
<FilesMatch "^index\.php$">
    Require all granted
</FilesMatch>

# ---------------------------------------------------------------------------
# 4. Sensitive files by name / extension.
#    robots.txt and sitemap.xml are intentionally NOT matched.
# ---------------------------------------------------------------------------
<FilesMatch "(composer\.(json|lock)|package\.json|package-lock\.json|phpunit\.xml|phpstan\.neon|phpstan-baseline\.neon|phpcs\.xml|webpack\.mix\.js|vitest\.config\.js|cypress\.config\.js|crontab\.txt|\.(env|sql|sh|bash|log|lock|neon|dist|bak|orig|save|swp|cache|md)$)">
    Require all denied
</FilesMatch>

# ---------------------------------------------------------------------------
# 5. Security response headers
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(self), camera=(self), microphone=(), payment=(self)"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always unset X-Powered-By
    Header unset X-Powered-By

    # HSTS: all HTTPS environments
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # CORP: Prevents cross-origin resource theft
    Header always set Cross-Origin-Resource-Policy "cross-origin"
</IfModule>

# ---------------------------------------------------------------------------
# 6. Front-controller routing
# ---------------------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]

Options -Indexes

# ---------------------------------------------------------------------------
# 7. Static asset caching
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/pdf "access plus 1 month"
  ExpiresByType text/x-javascript "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresDefault "access plus 2 days"
</IfModule>
