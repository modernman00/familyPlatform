# ==============================================================================
# DEPLOYMENT ALLOWLIST & PROTECTED PATHS (.rsync-filter)
# Evaluated Top-Down: First Match Wins
# ==============================================================================

# 1. PROTECT (P) server-only runtime files from --delete / --delete-excluded
P /.env
P /.env_production
P /storage/***
P /public/uploads/***
P /resources/images/***
P /bootstrap/log/***
P /bootstrap/cache/***

# 2. EXCLUDE user uploads from local sync
- /public/uploads/***
- /resources/images/***
- /storage/***

# 3. ALLOWLIST (+) Core Application Code & Compiled Assets
+ /app/***
+ /bootstrap/***
+ /cron/***
+ /public/***
# Include the resources/ dir itself so rsync descends into it; the '- *' rule
# below would otherwise prune the whole tree and --delete-excluded would wipe
# resources/views on the server (every Blade view -> "Template not found").
+ /resources/
+ /resources/views/***
+ /resources/asset/***
+ /resources/fonts/***
+ /vendor/***
+ /index.php
+ /service-worker.js
+ /manifest.json
+ /offline.html
+ /robots.txt
+ /favicon.ico
+ /.htaccess
+ /composer.json
+ /composer.lock

# 4. EXCLUDE (-) Everything else (Dev scripts, tests, cypress, markdown, etc.)
- *
