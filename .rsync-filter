# ==============================================================================
# DEPLOYMENT ALLOWLIST & PROTECTED PATHS (.rsync-filter)
# Evaluated Top-Down: First Match Wins
# ==============================================================================

# 1. PROTECT (P) server-only runtime files and user uploads
P /.env
P /.env_production
P /storage/***
P /public/uploads/***
P /public/media/***
P /resources/images/***
P /resources/images/profile/***
P /resources/images/post/***
P /resources/assets/images/***
P /resources/asset/images/***
P /bootstrap/log/***
P /bootstrap/cache/***

# 2. EXCLUDE user runtime uploads from overwriting remote state
- /public/uploads/***
- /public/media/***
- /resources/images/profile/***
- /resources/images/post/***
- /storage/***

# 3. ALLOWLIST (+) Core Application Code & Compiled Assets
+ /app/***
+ /bootstrap/***
+ /cron/***
+ /public/***
+ /resources/
+ /resources/views/***
+ /resources/asset/***
+ /resources/assets/***
+ /resources/fonts/***
+ /scripts/
+ /vendor/***
+ /index.php
+ /service-worker.js
+ /sw.js
+ /manifest.json
+ /offline.html
+ /robots.txt
+ /favicon.ico
+ /.htaccess
+ /composer.json
+ /composer.lock

# 4. EXCLUDE (-) Everything else (Dev scripts, tests, cypress, markdown, etc.)
- *

